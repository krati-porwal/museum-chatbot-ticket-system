# Copy this file to .env and fill in your SMTP credentials to enable emailing
# Example for Gmail with App Password (recommended):
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=your.email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# FROM_EMAIL=tickets@yourdomain.com  # optional, defaults to SMTP_USERNAME

# If you use port 587 (STARTTLS) set SMTP_PORT=587

# Optional: other config
# DATABASE_URL=postgresql+psycopg2://museum_user:password@localhost:5432/museum_chatbot
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
